# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/

# Credentials: never track
.env
.env.*
*.pem
*.key
.netrc

# Data store: parquet files are regenerated by the fetchers; the manifest stays tracked
data/**/*.parquet
data/**/*.parquet.tmp
data/raw/

# Raw per-window forecasts and other large run artefacts are regenerated by the harness
results/stage4/forecast/
results/stage4/esr_inputs/
results/stage4/ctxfits/
results/stage4/**/*.log
results/**/*.pre-v20.csv

# Model / HF caches
*.ckpt
*.safetensors
.cache/

# Vendored R libraries (regenerable from CRAN)
tests/fixtures/rlib_local/

# LaTeX build artefacts
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.spl
